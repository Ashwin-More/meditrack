# =============================================================================
# MediTrack – environment template
# Copy to `.env` and fill in real values:   cp .env.example .env
# Never commit `.env` (only this example file).
# Read by: docker-compose.yml  (and, for local runs, export the same names).
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL / database
# -----------------------------------------------------------------------------
# Password for the MySQL root user. NOTE: MySQL only applies this the FIRST time
# the volume is created. If you change it later, run `docker compose down -v`
# (this deletes the data) or change it inside MySQL.
DB_PASSWORD=change-me-strong-db-password
DB_NAME=meditrack
DB_USER=root

# Host port that exposes MySQL (for MySQL Workbench / DBeaver / local `mvn`).
# Inside Docker the backend always talks to mysql:3306.
MYSQL_HOST_PORT=3307

# -----------------------------------------------------------------------------
# Ports published on your machine
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5500

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
# REQUIRED. At least 32 characters, random. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# access token: 24 hours
JWT_EXPIRATION_MS=86400000
# refresh token: 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# Login rate limiter (per client)
LOGIN_RATE_LIMIT_MAX=5
# seconds
LOGIN_RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# URLs / CORS
# -----------------------------------------------------------------------------
# Public URL of the frontend (informational; kept for reference / future use —
# verification and password-reset now use OTP codes, not links).
FRONTEND_URL=http://localhost:5500

# Comma-separated list of browser origins allowed to call the API (no spaces).
# Must include FRONTEND_URL.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# true  = send real email using the SMTP settings below (REQUIRES MAIL_USERNAME + MAIL_PASSWORD).
#         logs instead (no SMTP account needed – best for development).
# true  = send real email using the SMTP settings below.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
# For Gmail use an App Password (Google Account > Security > App passwords),
# not your normal password.
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=youraddress@gmail.com

# -----------------------------------------------------------------------------
# SMS (OTP delivery for phone-number login/verification)
# -----------------------------------------------------------------------------
# false = don't send; the code is printed in the backend console (no SMS
#         provider account needed – best for development).
# true  = send real SMS. No provider is wired up in this project by default;
#         implement the actual call (Twilio / MSG91 / AWS SNS / etc.) in
#         backend/src/main/java/com/meditrack/service/SmsServiceImpl.java first.
SMS_ENABLED=false
SMS_FROM=MEDITRACK

# Token / OTP lifetimes
EMAIL_VERIFY_MINUTES=10
PASSWORD_RESET_MINUTES=30
LOGIN_OTP_MINUTES=5

# -----------------------------------------------------------------------------
# Backend behaviour
# -----------------------------------------------------------------------------
# Where uploaded test reports are stored inside the container (persisted in the
# `meditrack_uploads` volume).
UPLOAD_DIR=uploads/reports

# Flyway owns the schema; Hibernate only validates it.
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# Log SQL statements: INFO = off, DEBUG = on
SQL_LOG=INFO

# -----------------------------------------------------------------------------
# OTP security
# -----------------------------------------------------------------------------
# OTP codes are only delivered by email/SMS. They are never returned by the API,
# shown on screen, or written to the logs.
# Wrong guesses allowed per code before it is locked (user must request a new one).
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two codes being sent to the same account.
OTP_RESEND_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# Demo accounts (superadmin / admin / drrahul / nursepriya)
# -----------------------------------------------------------------------------
# Real inbox for the demo accounts' OTP emails. you@gmail.com -> you+superadmin@gmail.com, ...
SEED_EMAIL_BASE=
# Recovery switch: true = reset the 4 demo passwords to their defaults on next start.
SEED_RESET_DEMO_PASSWORDS=false
