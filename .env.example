# =============================================================================
# MediTrack – environment template
# Copy to `.env` and fill in real values:   cp .env.example .env
# Never commit `.env` (only this example file).
# Read by: docker-compose.yml  (and, for local runs, export the same names).
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL / database
# -----------------------------------------------------------------------------
# Password for the MySQL root user. NOTE: MySQL only applies this the FIRST time
# the volume is created. If you change it later, run `docker compose down -v`
# (this deletes the data) or change it inside MySQL.
DB_PASSWORD=change-me-strong-db-password
DB_NAME=meditrack
DB_USER=root

# Host port that exposes MySQL (for MySQL Workbench / DBeaver / local `mvn`).
# Inside Docker the backend always talks to mysql:3306.
MYSQL_HOST_PORT=3307

# -----------------------------------------------------------------------------
# Ports published on your machine
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5500

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
# REQUIRED. At least 32 characters, random. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# access token: 24 hours
JWT_EXPIRATION_MS=86400000
# refresh token: 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# Login rate limiter (per client)
LOGIN_RATE_LIMIT_MAX=5
# seconds
LOGIN_RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# URLs / CORS
# -----------------------------------------------------------------------------
# Public URL of the frontend. Used to build the links in verification and
# password-reset emails.
FRONTEND_URL=http://localhost:5500

# Comma-separated list of browser origins allowed to call the API (no spaces).
# Must include FRONTEND_URL.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# true  = send real email using the SMTP settings below (REQUIRES MAIL_USERNAME + MAIL_PASSWORD).
#         logs instead (no SMTP account needed – best for development).
# true  = send real email using the SMTP settings below.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
# For Gmail use an App Password (Google Account > Security > App passwords),
# not your normal password.
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=youraddress@gmail.com

# Token lifetimes
EMAIL_VERIFY_HOURS=24
PASSWORD_RESET_MINUTES=30

# -----------------------------------------------------------------------------
# Backend behaviour
# -----------------------------------------------------------------------------
# Where uploaded test reports are stored inside the container (persisted in the
# `meditrack_uploads` volume).
UPLOAD_DIR=uploads/reports

# Flyway owns the schema; Hibernate only validates it.
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# Log SQL statements: INFO = off, DEBUG = on
SQL_LOG=INFO
